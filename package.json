{
  "name": "directree.js",
  "version": "0.1.3",
  "description": "Create directory trees with files and content",
  "type": "module",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@12.3.4",
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "pnpm run build",
    "test": "vitest run",
    "release:major": "pnpm version major && git push --follow-tags",
    "release:minor": "pnpm version minor && git push --follow-tags",
    "release:patch": "pnpm version patch && git push --follow-tags",
    "release:premajor": "pnpm version $(node -p \"require('./package.json').version.includes('-') ? 'prerelease' : 'premajor'\") --preid=beta && git push --follow-tags",
    "release:preminor": "pnpm version $(node -p \"require('./package.json').version.includes('-') ? 'prerelease' : 'preminor'\") --preid=beta && git push --follow-tags"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kdabir/directree.js.git"
  },
  "author": "kdabir",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/kdabir/directree.js/issues"
  },
  "homepage": "https://github.com/kdabir/directree.js#readme",
  "devDependencies": {
    "@types/node": "^22.20.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  }
}
